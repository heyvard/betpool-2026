{
    "hooks": {
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
                    }
                ]
            }
        ],
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "if": "Bash(git *)",
                        "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit-format.sh",
                        "timeout": 120,
                        "statusMessage": "Kjører pnpm format før commit …"
                    },
                    {
                        "type": "command",
                        "if": "Bash(git *)",
                        "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit-verify.sh",
                        "timeout": 600,
                        "statusMessage": "Kjører tsc + e2e før commit …"
                    }
                ]
            }
        ]
    }
}
