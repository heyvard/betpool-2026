{
    "framework": "nextjs",
    "buildCommand": "pnpm vercel-build",
    "git": {
        "deploymentEnabled": {
            "main": false
        }
    },
    "crons": [
        {
            "path": "/api/cron/send-reminders",
            "schedule": "0 15 * * *"
        },
        {
            "path": "/api/cron/sync-matches",
            "schedule": "0 * * * *"
        }
    ]
}
